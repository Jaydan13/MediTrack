<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Top Dashboard Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_margin="16dp"
        android:background="#4F46E5"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnAddMedication"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:src="@android:drawable/ic_input_add"
            android:tint="#FFFFFF"
            android:contentDescription="Add Medication"/>
    </LinearLayout>

    <!-- Hover Text -->
    <TextView
        android:id="@+id/txtAddHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Medication"
        android:textColor="#555555"
        android:textSize="12sp"
        android:layout_gravity="end"
        android:layout_marginEnd="32dp"
        android:visibility="gone"/>

    <!-- Date & Time -->
    <TextView
        android:id="@+id/txtDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monday, 18 January 2026 • 16:30"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"/>

    <!-- Medication Reminder List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Example Reminder Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paracetamol"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Take at 08:00 AM"
                    android:textColor="#555555"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#4F46E5"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- Home -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/homeButton"
                android:src="@drawable/ic_homepage"
                android:contentDescription="Home "
                android:background="@null"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"/>
        </LinearLayout>

        <!-- Records -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/recordsButton"
                android:src="@drawable/ic_records"
                android:contentDescription="Records"
                android:background="@null"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"/>
        </LinearLayout>

        <!-- Inventory -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/inventoryButton"
                android:src="@drawable/ic_inventory"
                android:contentDescription="Inventory"
                android:background="@null"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"/>
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/settingsButton"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                android:background="@null"
                android:scaleType="fitCenter"
                android:tint="#FFFFFF"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
